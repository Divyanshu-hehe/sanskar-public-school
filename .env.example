# Sanskar Public School — Environment Variables Configuration

# Flask Secret Key for sessions and CSRF
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Database URL
# Default development uses local SQLite: sqlite:///sanskar_school.db
# In production on Render/Heroku/AWS, provide PostgreSQL URI:
# DATABASE_URL=postgresql://user:password@host:port/dbname
DATABASE_URL=sqlite:///sanskar_school.db

# Flask Application Port
PORT=5000

# Environment Mode
FLASK_ENV=development
